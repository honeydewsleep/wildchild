// Copy to include/config.h and edit. config.h is git-ignored.
#pragma once

// ---------------------------------------------------------------- network
#define WIFI_SSID        "your-wifi"
#define WIFI_PASS        "your-password"

// Apps Script web-app URL (Deploy -> New deployment -> Web app -> "Anyone").
#define SHEET_URL        "https://script.google.com/macros/s/AKfycb.../exec"
// Shared secret; must match API_KEY in backend/Code.gs.
#define API_KEY          "change-me"

// POSIX TZ string used for on-device timestamps (America/New_York shown).
#define TZ_INFO          "EST5EDT,M3.2.0,M11.1.0"

// ---------------------------------------------------------------- station
#define STATION_ID       "blower-1"      // unique per device, no spaces
#define STATION_NAME     "Blower 1"      // shown on the screen + dashboard

// ---------------------------------------------------------------- buttons
// All buttons wire between the GPIO and GND (active-low). -1 disables.
//
// CYD spare pins:  CN1 connector = GND, IO22, IO27, 3V3
//                  P3  connector = GND, IO35, IO22, IO21(backlight - don't use)
// IO35 is INPUT-ONLY with no internal pull-up: add a 10k resistor from
// IO35 to 3V3 when you use it.
#define PIN_BTN_ADD      22   // momentary: +1 pillow
#define PIN_BTN_SUB      27   // momentary: -1 pillow (undo)
#define PIN_BTN_BATCH    35   // latching switch: ON = batch running (needs ext. pull-up)
#define BTN_BATCH_LATCHING true   // false = momentary toggle button instead
#define PIN_BTN_DEFECT   -1   // optional momentary: log a defective skin

// ---------------------------------------------------------------- timing
#define HEARTBEAT_S      30   // live-state push interval while online
#define CONFIG_REFRESH_S 600  // re-fetch operator / pillow-type lists
#define FINISH_CONFIRM_MS 4000  // touch FINISH twice within this window
